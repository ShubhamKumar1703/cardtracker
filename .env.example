# ==============================================================================
# CARDTRACKER ENVIRONMENT VARIABLES
# ==============================================================================

# SUPABASE CLIENT CONFIG (Safe for client browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# SUPABASE SERVICE ROLE (Server-side ONLY - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# GROQ CLOUD API (Server-side ONLY - Free Tier fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# INGESTION SECRET TOKEN (Bearer token used by Google Apps Script to authenticate to /api/ingest/email)
INGESTION_SECRET_TOKEN=cardtracker_secure_token_secret_12345

# OPTIONAL: PERSONAL ACCOUNT CONTEXT
# CARDTRACKER_USER_ID=your-supabase-auth-user-uuid
